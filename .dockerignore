# Что не должно попадать в образ.
#
# Смысл не только в размере: данные пользователя и исходные выгрузки
# в публичный образ класть нельзя, а пояснительная записка и диаграммы
# к работе сервера отношения не имеют.

.git/
.gitignore
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# данные и выгрузки
data/
catboost_info/

# документация и материалы курсовой работы
docs/
*.md
!README.md

# локальные запускалки для Windows
*.bat

# то, что не участвует в работе сервера
tests/
api/
notebooks/
