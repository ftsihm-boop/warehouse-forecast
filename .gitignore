__pycache__/
*.py[cod]
.venv/
venv/
.env
data/raw_1c/
data/*.parquet
data/*.csv
data/*.xlsx
# Демонстрационные файлы — исключение: они маленькие, генерируются
# скриптом и нужны каждому, кто открывает репозиторий, чтобы проверить
# систему, не имея собственной выгрузки продаж.
!data/demo_*.xlsx
# Обученные модели по умолчанию не хранятся в репозитории: они бывают
# большими и меняются при каждом обучении. Исключение — models/global:
# именно эта модель попадает в образ при развёртывании, и без неё сервер
# на площадке свалился бы на статистический прогноз. Её размер около
# 2 МБ, для git это нормально.
models/*/
!models/global/
!models/.gitkeep
.pytest_cache/
.ipynb_checkpoints/
catboost_info/
.DS_Store
